    {
      "id": "353-probability-binomial-foundation-b4",
      "course": "353-probability-binomial-foundation",
      "version": "0.1",
      "originalQuestion": {
        "type": "single",
        "stem": "n=10、p=0.2时E(X)=2的正确解释？",
        "options": [
          "反复同类整组试验的平均计数为2",
          "每一组必定恰好2",
          "单次成功概率为2"
        ],
        "answer": 0,
        "explanation": "期望是模型下的平均计数，可不是每组保证。B混淆随机结果与均值，C把计数和概率混用且概率超过1。",
        "id": "353-probability-binomial-foundation-b4",
        "difficulty": "foundation",
        "errorCauseHint": "concept"
      },
      "questionSHA256": "2b864dece845ce27c0d20c1b991a734201622642dc4b28425a7dbccb9ebfa2eb",
      "independentlyReasonedAnswer": 0,
      "sourceIds": [
        "NIST_BIN"
      ],
      "directSupport": "E(X)=np=2 is a model expectation, not a guaranteed realized count.",
      "fullQuestionVerified": false,
      "expertApproved": false,
      "minimalRevision": "Retain model/research-question scope; no answer change."
    },
    {
      "id": "353-anova-chi-regression-foundation-b4",
      "course": "353-anova-chi-regression-foundation",
      "version": "0.1",
      "originalQuestion": {
        "id": "353-anova-chi-regression-foundation-b4",
        "type": "single",
        "stem": "在Logistic回归中一个自变量系数β1被取指数exp(β1)，得到的通常是什么？",
        "options": [
          "模型条件下与该变量单位变化对应的优势比OR",
          "在所有人群中固定不变的绝对风险",
          "患者未来肯定会发病的概率"
        ],
        "answer": 0,
        "explanation": "A正确。exp(β1)对应优势比OR，不能直接等同风险比RR或绝对患病概率。",
        "difficulty": "foundation"
      },
      "questionSHA256": "c4e9d68f08bbd08e8d15d4e3d1709ac56575aaf866e1bb81c7315667ef064037",
      "independentlyReasonedAnswer": 0,
      "sourceIds": [
        "UCLA_OR"
      ],
      "directSupport": "In the taught linear-logit model without interactions, unit increase in x has conditional odds ratio exp(beta). Interaction/polynomial coding requires the appropriate contrast, not a universal coefficient shortcut.",
      "fullQuestionVerified": false,
      "expertApproved": false,
      "minimalRevision": "Keep no-interaction model boundary; associated beta-vs-x teaching wording correction is held separately, not silently applied to old sessions."
    },
    {
      "id": "353-anova-chi-regression-foundation-a1",
      "course": "353-anova-chi-regression-foundation",
      "version": "0.1",
      "originalQuestion": {
        "id": "353-anova-chi-regression-foundation-a1",
        "type": "single",
        "stem": "当二分类结局用Logistic回归建模时，下列哪种说法最严谨？",
        "options": [
          "OR=2意味着每个人的发病概率都正好翻倍",
          "OR=2描述模型条件下优势（odds）的比值，未必是RR=2",
          "有Logistic模型就不需要检查研究设计和混杂"
        ],
        "answer": 1,
        "explanation": "B正确。OR比较优势，不直接等于风险或风险比，也不能替代研究设计的因果论证。",
        "difficulty": "application"
      },
      "questionSHA256": "bae54883e470096a3ff887e2885b94a25d64d94589095ebee99d65ec64d5059e",
      "independentlyReasonedAnswer": 1,
      "sourceIds": [
        "UCLA_OR"
      ],
      "directSupport": "Odds p/(1-p) is not probability; an odds ratio2 need not be a risk ratio2.",
      "fullQuestionVerified": false,
      "expertApproved": false,
      "minimalRevision": "Keep no-interaction model boundary; associated beta-vs-x teaching wording correction is held separately, not silently applied to old sessions."
    },
    {
      "id": "353-trial-design-effects-b1",
      "course": "353-trial-design-effects",
      "version": "0.1-issue9-3",
      "originalQuestion": {
        "type": "single",
        "stem": "哪项正确区分随机分配与随机抽样？",
        "options": [
          "两者始终等价",
          "抽样选入组对象，分配决定入组后干预组别",
          "随机分配保证每项基线值完全相同"
        ],
        "answer": 1,
        "explanation": "选择样本与指定干预是不同环节；随机只在概率意义上实现平衡，不能保证每次样本完全相同。",
        "id": "353-trial-design-effects-b1",
        "difficulty": "basic",
        "sourceRefs": [
          "original-EPI07",
          "cdc-methods",
          "tsinghua-2027"
        ]
      },
      "questionSHA256": "c7b55df93a998808f612249cb6561be3d5752032c7bd404a584a819248715629",
      "independentlyReasonedAnswer": 1,
      "sourceIds": [
        "CONSORT2010",
        "STATCAN_SAMPLING"
      ],
      "directSupport": "Random sampling selects survey units; random allocation assigns enrolled participants to interventions. Neither guarantees identical realized baseline values.",
      "fullQuestionVerified": false,
      "expertApproved": false,
      "minimalRevision": "Retain model/research-question scope; no answer change."
    },
    {
      "id": "353-trial-design-effects-b3",
      "course": "353-trial-design-effects",
      "version": "0.1-issue9-3",
      "originalQuestion": {
        "type": "single",
        "stem": "试验一位参加者停止干预且结局仍未知，哪项正确？",
        "options": [
          "未知不自动等于未发病，应报告并尽量取得结局",
          "停止干预立即证明没有结局",
          "可以随意改到另一组以放大效果"
        ],
        "answer": 0,
        "explanation": "退出干预与未知结局是不同问题，原分组原则不授权伪造结局；按可行伦理程序补随访和适当方案处理。",
        "id": "353-trial-design-effects-b3",
        "difficulty": "basic",
        "sourceRefs": [
          "original-EPI07",
          "cdc-methods",
          "tsinghua-2027"
        ]
      },
      "questionSHA256": "946cb3427363f7ac50d9f5081d27f154436e6ef10c36c8c257cefd54c32dfe09",
      "independentlyReasonedAnswer": 0,
      "sourceIds": [
        "ICH_E9R1"
      ],
      "directSupport": "Stopping treatment is distinct from study withdrawal; unknown outcomes cannot be invented as no events, and follow-up should address the estimand.",
      "fullQuestionVerified": false,
      "expertApproved": false,
      "minimalRevision": "Retain model/research-question scope; no answer change."
    },
    {
      "id": "353-trial-design-effects-a3",
      "course": "353-trial-design-effects",
      "version": "0.1-issue9-3",
      "originalQuestion": {
        "type": "multi",
        "stem": "出现失访和不依从时哪些合理？",
        "options": [
          "尽量保留原随机分组并补结局",
          "全部未知结局按未发病填0",
          "报告流向并依据方案评价缺失影响"
        ],
        "answer": [
          0,
          2
        ],
        "explanation": "A/C保留设计与缺失问题；意向性原则不授权随意插补未知结局，也不自动保证无偏。",
        "id": "353-trial-design-effects-a3",
        "difficulty": "application",
        "sourceRefs": [
          "original-EPI07",
          "cdc-methods",
          "tsinghua-2027"
        ]
      },
      "questionSHA256": "68bd77712759ea69cd3b40b522bc6950078ebfc1262fd565e11a47894c0b5ff1",
      "independentlyReasonedAnswer": [
