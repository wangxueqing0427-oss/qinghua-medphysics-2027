  "concepts": {
    "continuous": {
      "sources": [
        "BC_CONT"
      ],
      "support": "am/is/are + ing expresses the stated ongoing action; be moves before subject in questions. know in its ordinary state meaning normally uses simple aspect.",
      "limits": "Not a universal equation of now with continuous: future arrangements, temporary states and marked stative uses require context. Spelling-specific questions remain pending."
    },
    "habit": {
      "sources": [
        "BC_SIMPLE"
      ],
      "support": "Regular habits use present simple in these explicitly habitual contexts; third-person singular uses s.",
      "limits": "Does not exclude narrative present or marked repeated continuous uses."
    },
    "passive": {
      "sources": [
        "BC_PASSIVE",
        "BC_BE"
      ],
      "support": "For the stated transitive action reading, passive uses be plus past participle, optional by identifies agent; be carries agreement, tense and negation.",
      "limits": "No universal passive transformation for every verb; clean adjectival alternative is not the requested complete passive. written morphology and sleep lexical transitivity are retained pending specific source checks."
    }
